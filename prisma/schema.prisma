generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Project {
  id        String   @id @default(uuid())
  name      String
  path      String
  color     String   @default("#3b82f6")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  threads   Thread[]

  @@map("projects")
}

model Thread {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  title     String
  provider  String   @default("openai")
  model     String   @default("gpt-5.1-codex-mini")
  effort       String   @default("medium")
  approvalMode String   @default("suggest") @map("approval_mode")
  sessionId    String?  @map("session_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@map("threads")
}

model Message {
  id        String   @id @default(uuid())
  threadId  String   @map("thread_id")
  role      String
  content   String
  metadata  String?
  createdAt DateTime @default(now()) @map("created_at")
  thread    Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@map("messages")
}

model BenchmarkRun {
  id                 String            @id @default(uuid())
  createdAt          DateTime          @default(now()) @map("created_at")
  providersJson      String            @map("providers_json")
  profilesJson       String            @map("profiles_json")
  totalModels        Int               @map("total_models")
  totalCases         Int               @map("total_cases")
  succeededCases     Int               @map("succeeded_cases")
  failedCases        Int               @map("failed_cases")
  recommendedProvider String?          @map("recommended_provider")
  recommendedModel   String?           @map("recommended_model")
  results            BenchmarkResult[]

  @@map("benchmark_runs")
}

model BenchmarkResult {
  id            String       @id @default(uuid())
  runId         String       @map("run_id")
  provider      String
  model         String
  profile       String
  durationMs    Int          @map("duration_ms")
  outputChars   Int          @map("output_chars")
  charsPerSecond Float       @map("chars_per_second")
  success       Int
  error         String?
  createdAt     DateTime     @default(now()) @map("created_at")
  run           BenchmarkRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId], map: "idx_benchmark_results_run_id")
  @@index([profile], map: "idx_benchmark_results_profile")
  @@map("benchmark_results")
}
